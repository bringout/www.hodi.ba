---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: nowrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	h2 { margin: 0; font-size: 1em; }
	h2 a, h2 a.active { text-decoration: none; }
	.logo { height: 40px; width: auto; vertical-align: middle; display: block; }

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}

	/* Hamburger toggle (pure CSS, no JS) */
	.nav-toggle {
		display: none;
	}
	.nav-toggle-label {
		display: none;
		cursor: pointer;
		padding: 0.75em;
		margin: 0 -0.5em 0 0;
		user-select: none;
	}
	.nav-toggle-label span,
	.nav-toggle-label span::before,
	.nav-toggle-label span::after {
		display: block;
		background: var(--accent);
		height: 3px;
		width: 26px;
		border-radius: 2px;
		position: relative;
		transition: transform 0.2s ease, top 0.2s ease, bottom 0.2s ease;
	}
	.nav-toggle-label span::before,
	.nav-toggle-label span::after {
		content: '';
		position: absolute;
	}
	.nav-toggle-label span::before { bottom: 8px; }
	.nav-toggle-label span::after { top: 8px; }
	.nav-toggle:checked + .nav-toggle-label span {
		background: transparent;
	}
	.nav-toggle:checked + .nav-toggle-label span::before {
		bottom: 0;
		transform: rotate(45deg);
		background: var(--accent);
	}
	.nav-toggle:checked + .nav-toggle-label span::after {
		top: 0;
		transform: rotate(-45deg);
		background: var(--accent);
	}

	@media (max-width: 768px) {
		header { padding: 0 0.75em; }
		.nav-toggle-label { display: inline-flex; align-items: center; }

		.internal-links {
			display: none;
			position: absolute;
			top: 56px;
			left: 0;
			right: 0;
			background: white;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5em 0;
			box-shadow: 0 4px 12px rgba(var(--black), 8%);
			z-index: 100;
		}
		.nav-toggle:checked ~ .internal-links {
			display: flex;
		}
		.internal-links a {
			padding: 0.9em 1.25em;
			border-bottom: 1px solid rgb(var(--gray-light));
			border-left: 4px solid transparent;
		}
		.internal-links a:last-child { border-bottom: none; }
		.internal-links a.active {
			border-bottom-color: rgb(var(--gray-light));
			border-left-color: var(--accent);
			background: rgba(var(--gray-light), 0.4);
		}
		nav { position: relative; min-height: 56px; }
	}
</style>

<header>
	<nav>
		<h2><a href="/"><img src="/logo.svg" alt="Hodi!" class="logo" /></a></h2>
		<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Otvori meni" />
		<label for="nav-toggle" class="nav-toggle-label" aria-hidden="true"><span></span></label>
		<div class="internal-links">
			<HeaderLink href="/">Početna</HeaderLink>
			<HeaderLink href="/about">O nama</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<a href="https://registracija.kep.hodi.ba" target="_blank">Registracija</a>
			<a href="https://provjeri.kep.hodi.ba" target="_blank">KEP verifikator</a>
			<a href="https://webmail.hodi.ba" target="_blank" data-webmail-link>Webmail</a>
		</div>
	</nav>
</header>

<script>
	// Hide Webmail link if the logged-in Authelia user is not on @hodi.ba.
	// /api/whoami returns 401 for unauthenticated users → keep default state.
	fetch('/api/whoami', { credentials: 'same-origin' })
		.then((r) => (r.ok ? r.json() : null))
		.then((d) => {
			if (d && d.email && !d.email.toLowerCase().endsWith('@hodi.ba')) {
				document.querySelectorAll('[data-webmail-link]').forEach((el) => el.remove());
			}
		})
		.catch(() => {});
</script>
